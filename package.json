{
  "name": "aurovie-charts",
  "version": "0.7.2",
  "description": "Framework-agnostic canvas charting engine — a TradingView-class financial chart (candles/volume, indicators, drawings, crosshair, pan/zoom) with a datafeed abstraction. React-free core; optional ./react binding.",
  "license": "MIT",
  "author": "Harsh Kumar Sah",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./standalone": "./dist/aurovie-charts.standalone.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsup && node scripts/preserve-use-client.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisisharshsah/aurovie-charts.git"
  },
  "homepage": "https://github.com/thisisharshsah/aurovie-charts#readme",
  "bugs": {
    "url": "https://github.com/thisisharshsah/aurovie-charts/issues"
  },
  "keywords": [
    "charting",
    "candlestick",
    "financial-charts",
    "ohlc",
    "canvas",
    "technical-analysis",
    "indicators",
    "trading",
    "datafeed",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  }
}
